{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deposition configuration",
  "description": "Files in config/semantic-types/ contain a list of semantic types; files in config/profiles/ contain one deposition profile.",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "semanticTypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "definition"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "label": {"$ref": "#/$defs/text"},
          "definition": {"$ref": "#/$defs/text"},
          "uri": {"type": "string", "pattern": "^https?://"},
          "requires_description": {"type": "boolean"},
          "search_filter": {"type": "boolean"}
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "revision", "dataset_category", "semantic_types", "requirements"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "revision": {"$ref": "#/$defs/text"},
        "dataset_category": {"$ref": "#/$defs/text"},
        "semantic_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "filename_patterns": {"type": "array", "items": {"$ref": "#/$defs/text"}},
              "formats": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"}
              }
            }
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "level", "min_files", "semantic_types"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/identifier"},
              "label": {"$ref": "#/$defs/text"},
              "level": {"enum": ["required", "recommended", "optional"]},
              "min_files": {"type": "integer", "minimum": 0},
              "max_files": {"type": "integer", "minimum": 1},
              "semantic_types": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/identifier"}
              },
              "help": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    }
  }
}
