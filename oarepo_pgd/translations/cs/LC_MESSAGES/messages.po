msgid "Dataset category"
msgstr "Kategorie datové sady"

msgid "File types"
msgstr "Typy souborů"

msgid "Select a deposition profile."
msgstr "Vyberte depoziční profil."

#, python-format
msgid ""
"%(profile)s: the profile has changed since it was selected. Select it "
"again and review the file meanings."
msgstr ""
"%(profile)s: profil se od svého výběru změnil. Vyberte ho znovu a "
"zkontrolujte významy souborů."

msgid "the file is annotated more than once. Keep one annotation."
msgstr "soubor má více anotací. Ponechte jen jednu."

msgid "select at least one file meaning."
msgstr "vyberte alespoň jeden význam souboru."

msgid "remove the repeated file meaning."
msgstr "odeberte opakovaný význam souboru."

#, python-format
msgid "%(label)s is not a file meaning in the %(profile)s profile."
msgstr "%(label)s není význam souboru v profilu %(profile)s."

#, python-format
msgid "%(label)s accepts %(formats)s files."
msgstr "%(label)s přijímá soubory %(formats)s."

#, python-format
msgid "%(label)s needs a description of what the file is."
msgstr "%(label)s vyžaduje popis toho, co soubor obsahuje."

#, python-format
msgid "%(label)s: %(found)s of at least %(num)s file."
msgid_plural "%(label)s: %(found)s of at least %(num)s files."
msgstr[0] "%(label)s: %(found)s z alespoň %(num)s souboru."
msgstr[1] "%(label)s: %(found)s z alespoň %(num)s souborů."
msgstr[2] "%(label)s: %(found)s z alespoň %(num)s souborů."

#, python-format
msgid ""
"%(label)s: %(found)s of at most %(num)s file. Remove or reassign the "
"extra files."
msgid_plural ""
"%(label)s: %(found)s of at most %(num)s files. Remove or reassign the "
"extra files."
msgstr[0] ""
"%(label)s: %(found)s z nejvýše %(num)s souboru. Odeberte nadbytečné "
"soubory, nebo jim přiřaďte jiný význam."
msgstr[1] ""
"%(label)s: %(found)s z nejvýše %(num)s souborů. Odeberte nadbytečné "
"soubory, nebo jim přiřaďte jiný význam."
msgstr[2] ""
"%(label)s: %(found)s z nejvýše %(num)s souborů. Odeberte nadbytečné "
"soubory, nebo jim přiřaďte jiný význam."

msgid "File meanings"
msgstr "Významy souborů"

msgid "Deposition profile"
msgstr "Depoziční profil"

msgid "File"
msgstr "Soubor"

msgid "Meaning"
msgstr "Význam"
