{
  "description": "Rule cases shared by test_rules.py and rules.test.mjs. Errors are the English texts as the server reports them (file key prefix included); counts are checked in the form only.",
  "configurations": {
    "field-work": {
      "semantic_types": [
        {
          "id": "site-photo",
          "label": "Site photo",
          "definition": "A photograph taken at the study site."
        },
        {
          "id": "field-notebook",
          "label": "Field notebook",
          "definition": "Notes written during fieldwork.",
          "uri": "https://example.org/terms/field-notebook"
        },
        {
          "id": "other",
          "label": "Other",
          "definition": "A file that none of the profile's types describe.",
          "requires_description": true
        }
      ],
      "profiles": [
        {
          "id": "field-survey",
          "revision": "1",
          "dataset_category": "Field survey",
          "semantic_types": [
            {
              "id": "site-photo",
              "filename_patterns": [
                "*.jpg",
                "*.png"
              ],
              "formats": [
                "jpg",
                "png",
                "tiff"
              ]
            },
            {
              "id": "field-notebook",
              "filename_patterns": [
                "*notes*"
              ]
            },
            {
              "id": "other",
              "filename_patterns": [
                "*"
              ]
            }
          ],
          "requirements": [
            {
              "id": "photos",
              "label": "Site photos",
              "level": "required",
              "min_files": 1,
              "max_files": 50,
              "semantic_types": [
                "site-photo"
              ],
              "help": "Upload at least one photo of the site."
            },
            {
              "id": "notes",
              "label": "Field notes",
              "level": "recommended",
              "min_files": 1,
              "semantic_types": [
                "field-notebook"
              ]
            }
          ]
        },
        {
          "id": "photo-only",
          "revision": "1",
          "dataset_category": "Photo collection",
          "semantic_types": [
            {
              "id": "site-photo"
            }
          ],
          "requirements": []
        }
      ]
    },
    "material": {
      "semantic_types": [
        {
          "id": "site-photo",
          "label": "Site photo",
          "definition": "A photograph taken at the study site."
        },
        {
          "id": "field-notebook",
          "label": "Field notebook",
          "definition": "Notes written during fieldwork.",
          "uri": "https://example.org/terms/field-notebook"
        },
        {
          "id": "other",
          "label": "Other",
          "definition": "A file that none of the profile's types describe.",
          "requires_description": true
        }
      ],
      "profiles": [
        {
          "id": "survey",
          "revision": "1",
          "dataset_category": "Survey",
          "semantic_types": [
            {
              "id": "site-photo"
            },
            {
              "id": "field-notebook"
            }
          ],
          "requirements": [
            {
              "id": "material",
              "label": "Field material",
              "level": "required",
              "min_files": 2,
              "semantic_types": [
                "site-photo",
                "field-notebook"
              ],
              "help": "Add photos or notes."
            },
            {
              "id": "notes",
              "label": "Notes",
              "level": "recommended",
              "min_files": 1,
              "max_files": 1,
              "semantic_types": [
                "field-notebook"
              ]
            }
          ]
        }
      ]
    },
    "empty": {
      "semantic_types": [],
      "profiles": []
    }
  },
